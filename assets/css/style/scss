@import "{{ site.theme }}";

.project-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  margin-top: 20px;
}

.project-card {
  background-color: #2a2a2a;
  border: 1px solid #3d3d3d;
  border-radius: 6px;
  padding: 20px;
  display: flex;
  flex-direction: column;
}

.project-card h3 {
  margin-top: 0;
  color: #ffffff;
}

.project-card p {
  flex-grow: 1;
  font-size: 0.95em;
  color: #cfcfcf;
}

.project-card a {
  margin-top: 10px;
  font-weight: bold;
}
